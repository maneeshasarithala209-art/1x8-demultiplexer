`timescale 1ns/1ps

module demux1x8_tb;

reg din;
reg [2:0] sel;
wire [7:0] dout;

demux1x8 uut(
    .din(din),
    .sel(sel),
    .dout(dout)
);

integer i;

initial begin

    $dumpfile("demux1x8.vcd");
    $dumpvars(0, demux1x8_tb);

    din = 1;

    for(i=0; i<8; i=i+1)
    begin
        sel = i;
        #10;
    end

    din = 0;

    for(i=0; i<8; i=i+1)
    begin
        sel = i;
        #10;
    end

    $finish;

end

endmodules